{
  "name": "dsh-skill-mcp-list",
  "version": "0.1.0",
  "description": "DSH 插件：查询当前已安装的 Skill 与 MCP，展示详细信息，并支持一键启用 / 禁用。",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./core": {
      "default": "./lib/core.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\""
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "skill",
    "mcp",
    "management"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
